# Azure AD B2C Configuration
# Copy this file to .env and fill in your actual values

# Your Azure AD B2C tenant name (the part before .b2clogin.com)
# Example: If your tenant is sugarbuddy.b2clogin.com, use: sugarbuddy
VITE_AZURE_AD_B2C_TENANT_NAME=your-tenant-name-here

# Your app registration's Application (client) ID (GUID format)
# Found in: Azure Portal > Azure AD B2C > App registrations > Your App > Overview
VITE_AZURE_AD_B2C_CLIENT_ID=your-client-id-here

# Your user flow/policy name (e.g., B2C_1_SignUpSignIn)
# Found in: Azure Portal > Azure AD B2C > User flows > Your User Flow
VITE_AZURE_AD_B2C_SIGN_UP_SIGN_IN_POLICY=your-policy-name-here

# API Endpoint (local development)
VITE_API_URL=http://localhost:7071/api
